{
  "name": "@kost/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/node.ts",
    "start": "tsx src/node.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
