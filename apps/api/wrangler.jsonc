{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panggora-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "769f5c8c01474fc1a281281293508aca",
    },
  ],
  "triggers": {
    "crons": ["0 1 * * *"],
  },
  "vars": {
    "BETTER_AUTH_URL": "https://panggora.my.id",
    "WEB_URL": "https://panggora.my.id",
    "ENVIRONMENT": "production",
    "COOKIE_SECURE": "true",
  },
}
